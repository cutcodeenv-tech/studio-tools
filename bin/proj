#!/usr/bin/env zsh

# Без этого повторный `local x` внутри цикла печатает "x=значение"
setopt typeset_silent

# ── КОНФИГ ──────────────────────────────────────────────────────────────────
STUDIO_DIR="$HOME/.studio-tools"
CONFIG_FILE="${STUDIO_DIR}/config"
TEMPLATE_DIR="${STUDIO_DIR}/template"
_UPDATE_FILE="${STUDIO_DIR}/.update_available"
_UPDATE_CACHE="${STUDIO_DIR}/.update_cache"

# ── OS detection ─────────────────────────────────────────────────────────────
case "$OSTYPE" in
    darwin*)       _OS="macos" ;;
    msys*|cygwin*) _OS="windows" ;;
    linux*)        _OS="linux" ;;
    *)             _OS="unknown" ;;
esac

_stat_size()  { [[ "$_OS" == "macos" ]] && stat -f%z "$1" 2>/dev/null || stat -c%s "$1" 2>/dev/null || echo 1; }
_stat_mtime() { [[ "$_OS" == "macos" ]] && stat -f%m "$1" 2>/dev/null || stat -c%Y "$1" 2>/dev/null || echo 0; }

if [[ ! -f "$CONFIG_FILE" ]]; then
    mkdir -p "$STUDIO_DIR"
    cat > "$CONFIG_FILE" <<'EOF'
PROJECTS_PARENT_ROOT=""
SSD_PROJECTS_ROOT="/Volumes/01_Extreme SSD/[001] Projects"
HDD_SOURCES_ROOT="/Volumes/HDD_1"
PREMIERE_TEMPLATE="/Volumes/01_Extreme SSD/[003] Resurces/00_TEMPLATE1.prproj"
EOF
fi

source "$CONFIG_FILE"

[[ ! -d "$TEMPLATE_DIR" ]] && mkdir -p "$TEMPLATE_DIR"

_check_deps() {
    local _cache="${STUDIO_DIR}/.deps_ok"
    if [[ -f "$_cache" ]] && \
       (( $(date +%s) - $(_stat_mtime "$_cache") < 86400 )) && \
       command -v gum &>/dev/null; then
        return 0
    fi

    case "$_OS" in
        macos)
            if ! command -v brew &>/dev/null; then
                print -P "%F{red}✗ Homebrew не установлен.%f"
                print -P "  /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
                return 1
            fi
            ;;
        windows)
            if ! command -v scoop &>/dev/null; then
                print -P "%F{cyan}  → Устанавливаю Scoop...%f"
                powershell -Command "Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force; irm get.scoop.sh | iex"
                export PATH="$HOME/scoop/shims:$PATH"
            fi
            ;;
    esac

    local _any=false

    if ! command -v gum &>/dev/null; then
        print -P "%F{cyan}  → Устанавливаю gum (меню)...%f"
        case "$_OS" in
            macos)   brew install gum ;;
            windows) scoop install charm-gum ;;
            *)       print -P "%F{red}✗ Установи gum: https://github.com/charmbracelet/gum#installation%f"; return 1 ;;
        esac
        _any=true
    fi
    [[ "$_any" == true ]] && print ""
    touch "$_cache"
    return 0
}
_check_deps || exit 1
# ────────────────────────────────────────────────────────────────────────────

PROJ_VERSION=$(git -C "$STUDIO_DIR" rev-parse --short HEAD 2>/dev/null || echo "?")

# ── ПРОГРЕСС-БАР ─────────────────────────────────────────────────────────────
# rsync --inplace пишет прямо в dst (прогресс-бар видит рост файла), --partial
# сохраняет недокачанное при обрыве — следующий sync заметит несовпадение
# размера и дозакончит. Проверяем флаги один раз: openrsync на новых macOS
# может их не знать — тогда откат на cp с предварительным удалением огрызка.
typeset -g _COPY_MODE=""
_copy_mode() {
    if [[ -z "$_COPY_MODE" ]]; then
        if command -v rsync &>/dev/null && rsync --partial --inplace --version &>/dev/null; then
            _COPY_MODE="rsync"
        else
            _COPY_MODE="cp"
        fi
    fi
    print -r -- "$_COPY_MODE"
}

copy_with_progress() {
    local src="$1" dst="$2" label="$3"
    local total=$(_stat_size "$src")
    (( total > 0 )) || total=1   # пустой файл — не делим на ноль
    local bar_width=30
    if [[ $(_copy_mode) == "rsync" ]]; then
        rsync --partial --inplace "$src" "$dst" 2>/dev/null &
    else
        rm -f "$dst"
        cp "$src" "$dst" &
    fi
    local cp_pid=$!
    while kill -0 $cp_pid 2>/dev/null; do
        local current=$(_stat_size "$dst")
        local pct=$(( current * 100 / total ))
        local filled=$(( pct * bar_width / 100 ))
        local bar=""
        for (( j=0; j<bar_width; j++ )); do
            (( j < filled )) && bar+="█" || bar+="░"
        done
        printf "\r  \033[33m⬇\033[0m  \033[90m[%s]\033[0m %3d%%  %s" "$bar" "$pct" "$label"
        sleep 0.15
    done
    wait $cp_pid; local _rc=$?
    local full_bar=$(printf '█%.0s' {1..$bar_width})
    (( _rc == 0 )) \
        && printf "\r  \033[32m✓\033[0m  \033[90m[%s]\033[0m 100%%  %s\n" "$full_bar" "$label" \
        || printf "\r  \033[31m✗\033[0m  копирование не удалось: %s\n" "$label"
    return $_rc
}

# ── ОТКРЫТЬ ПАПКУ ────────────────────────────────────────────────────────────
# Системный файловый менеджер: Finder / Проводник / xdg-open
_reveal() {
    local dir="$1"
    print -P "  %F{240}${dir}%f"
    case "$_OS" in
        macos)   open "$dir" ;;
        windows) explorer.exe "$(cygpath -w "$dir")" ;;
        *)       command -v xdg-open &>/dev/null && xdg-open "$dir" &>/dev/null & ;;
    esac
}

# ── ИНТЕРФЕЙС (gum) ──────────────────────────────────────────────────────────
# Esc в любом меню — назад (gum возвращает 1). Ctrl+C gum перехватывает сам
# и возвращает 130 — тогда гасим всё приложение, а не только текущий экран.
_C_ACCENT="#ff875f"
_C_HEAD="#5fafff"
_BACK="← Назад"
trap 'print ""; exit 130' INT

_gum() {
    gum "$@"; local rc=$?
    (( rc == 130 )) && kill -INT $$   # $$ — основной процесс и из $(...)
    return $rc
}

# _choose "Заголовок" пункт... → выбранный пункт
_choose() {
    local header="$1"; shift
    _gum choose --header="$header" --cursor="▸ " --height=15 --no-show-help \
        --cursor.foreground="$_C_ACCENT" --selected.foreground="$_C_ACCENT" \
        --header.foreground="$_C_HEAD" -- "$@"
}

# список на stdin | _filter "Заголовок" → выбранная строка, с поиском по вводу.
# Первый Esc снимает фокус с поиска, второй — назад.
_filter() {
    _gum filter --header="$1" --placeholder="Поиск…" --prompt="› " --indicator="▸" \
        --height=15 --header.foreground="$_C_HEAD" --prompt.foreground="$_C_ACCENT" \
        --indicator.foreground="$_C_ACCENT" --match.foreground="$_C_ACCENT"
}

# _input "Заголовок" [значение] [подсказка] → введённая строка
_input() {
    _gum input --header="$1" --value="${2:-}" --placeholder="${3:-}" --prompt="› " \
        --header.foreground="$_C_HEAD" --prompt.foreground="$_C_ACCENT"
}

# _confirm "Вопрос" → 0 да; 1 нет или Esc
_confirm() {
    _gum confirm --affirmative="Да" --negative="Нет" --default=false \
        --prompt.foreground="$_C_HEAD" --selected.background="$_C_ACCENT" "$1"
}

# ── ЗАПИСЬ В КОНФИГ ──────────────────────────────────────────────────────────
_config_set() {
    local key="$1" val="$2" tmpfile=$(mktemp) found=false
    while IFS= read -r line; do
        if [[ "$line" == "${key}="* ]]; then
            echo "${key}=\"${val}\"" >> "$tmpfile"; found=true
        else
            echo "$line" >> "$tmpfile"
        fi
    done < "$CONFIG_FILE"
    [[ "$found" == false ]] && echo "${key}=\"${val}\"" >> "$tmpfile"
    mv "$tmpfile" "$CONFIG_FILE"; source "$CONFIG_FILE"
}

_config_del() {
    grep -v "^${1}=" "$CONFIG_FILE" > "${CONFIG_FILE}.tmp"
    mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"; unset "$1"; source "$CONFIG_FILE"
}

# ── ВЫБОР ПРОЕКТА ────────────────────────────────────────────────────────────
# С PROJECTS_PARENT_ROOT проекты лежат на глубине 2 (категория/проект),
# без него — прямо в SSD_PROJECTS_ROOT. Имена начинаются с YYYY-MM-DD,
# поэтому sort -r даёт свежие сверху надёжнее, чем ls -t.
# Префикс срезаем через ${..#..}, а не sed: в путях вида "[001] Projects"
# скобки для sed — регулярка, и префикс бы не совпал.
_pick_project() {
    local header="${1:-Выберите проект}"
    local list
    if [[ -n "$PROJECTS_PARENT_ROOT" && -d "$PROJECTS_PARENT_ROOT" ]]; then
        local -a dirs=( "${PROJECTS_PARENT_ROOT}"/*/*(N/) )
        # сортируем по имени проекта (после "категория/"), а не по категории
        list=$(print -rl -- "${(@)dirs#${PROJECTS_PARENT_ROOT}/}" | sort -t/ -k2,2r)
    else
        local -a dirs=( "${SSD_PROJECTS_ROOT}"/*(N/:t) )
        list=$(print -rl -- "${(@)dirs}" | sort -r)
    fi
    if [[ -z "$list" ]]; then
        print -P "%F{yellow}  Проектов пока нет.%f" >&2; return 1
    fi
    print -r -- "$list" | _filter "$header  · Esc Esc — назад"
}

_project_ssd_path() {
    if [[ -n "$PROJECTS_PARENT_ROOT" && -d "$PROJECTS_PARENT_ROOT" ]]; then
        print -r -- "${PROJECTS_PARENT_ROOT}/$1"
    else
        print -r -- "${SSD_PROJECTS_ROOT}/$1"
    fi
}

# На HDD проекты лежат плоско, без категорий — берём только имя проекта
_project_hdd_path() {
    print -r -- "${HDD_SOURCES_ROOT}/${1:t}"
}

# ════════════════════════════════════════════════════════════════════════════
# СУБКОМАНДЫ
# ════════════════════════════════════════════════════════════════════════════

# ── proj new ─────────────────────────────────────────────────────────────────
cmd_new() {
    local H="Новый проект"
    local PROJECT_NAME CAM_COUNT
    PROJECT_NAME=$(_input "$H · название" "" "Например: Nike Promo") || return
    if [[ -z "${PROJECT_NAME// /}" ]]; then
        print -P "%F{red}Отменено: пустое название.%f\n"; return 1
    fi
    CAM_COUNT=$(_input "$H · сколько камер (1–10)" "2") || return
    if ! [[ "$CAM_COUNT" =~ ^[0-9]+$ ]] || (( CAM_COUNT < 1 || CAM_COUNT > 10 )); then
        CAM_COUNT=2
    fi

    local TARGET_ROOT="$SSD_PROJECTS_ROOT"
    if [[ -n "$PROJECTS_PARENT_ROOT" && -d "$PROJECTS_PARENT_ROOT" ]]; then
        local chosen_dir
        local -a cats=( "${PROJECTS_PARENT_ROOT}"/*(N/:t) )
        if (( ! ${#cats} )); then
            print -P "%F{red}✗ В ${PROJECTS_PARENT_ROOT} нет папок-категорий.%f\n"; return 1
        fi
        chosen_dir=$(print -rl -- "${(@)cats}" | _filter "$H · папка") || return
        TARGET_ROOT="${PROJECTS_PARENT_ROOT}/${chosen_dir}"
    fi

    print -P "\n%B%F{cyan}┌─ ${H}%f%b"
    print -P "%B%F{cyan}│%f%b  Название:  ${PROJECT_NAME}"
    print -P "%B%F{cyan}│%f%b  Камер:     ${CAM_COUNT}"
    [[ -n "$chosen_dir" ]] && print -P "%B%F{cyan}│%f%b  Папка:     ${chosen_dir}"
    print -P "%B%F{cyan}└────────────────────────────────────────┘%f%b"

    local DATE=$(date +%Y-%m-%d)
    # / и : в имени дали бы вложенные папки (: в Finder отображается как /)
    local SAFE_NAME="${PROJECT_NAME// /_}"
    SAFE_NAME="${SAFE_NAME//[\/:]/_}"
    while [[ "$SAFE_NAME" == .* ]]; do SAFE_NAME="${SAFE_NAME#.}"; done
    if [[ -z "$SAFE_NAME" ]]; then
        print -P "%F{red}✗ Недопустимое название.%f\n"; return 1
    fi
    local PROJECT_FOLDER_NAME="${DATE}_${SAFE_NAME}"
    local SSD_ROOT="${TARGET_ROOT}/${PROJECT_FOLDER_NAME}"
    local HDD_ROOT="${HDD_SOURCES_ROOT}/${PROJECT_FOLDER_NAME}"

    if [[ -d "$SSD_ROOT" ]]; then
        print -P "\n%F{red}✗ Папка уже существует: ${SSD_ROOT}%f\n"; return 1
    fi
    if [[ -d "$HDD_ROOT" ]]; then
        print -P "\n%F{red}✗ Папка уже существует на HDD: ${HDD_ROOT}%f\n"; return 1
    fi

    print -P "\n%F{yellow}Создаю структуру...%f"

    cp -r "${TEMPLATE_DIR}/." "$SSD_ROOT/"
    print -P "  %F{green}✓%f  Папки SSD"

    if [[ -f "$PREMIERE_TEMPLATE" ]]; then
        cp "$PREMIERE_TEMPLATE" "${SSD_ROOT}/01_Project_Files/Premiere/${SAFE_NAME}.prproj"
        print -P "  %F{green}✓%f  Шаблон Premiere"
    else
        print -P "  %F{yellow}⚠%f  Шаблон Premiere не найден"
    fi

    # Папки камер на SSD создаём всегда, на HDD — только если он смонтирован
    local hdd_ok=true
    [[ -d "$HDD_SOURCES_ROOT" ]] || hdd_ok=false
    local ALPHABET=( {a..z} )
    for (( i=1; i<=CAM_COUNT; i++ )); do
        local CAM="Cam_${ALPHABET[$i]}"
        mkdir -p "${SSD_ROOT}/02_Sources/Video/${CAM}/Proxy"
        $hdd_ok && mkdir -p "${HDD_ROOT}/02_Sources/Video/${CAM}"
        print -P "  %F{green}✓%f  ${CAM}"
    done
    $hdd_ok || print -P "  %F{yellow}⚠%f  HDD не смонтирован — папки камер на HDD не созданы"

    print -P "\n%F{green}%B✅ Готово:%b ${SSD_ROOT}%f\n"
    _confirm "Открыть папку проекта?" && _reveal "$SSD_ROOT"
}

# ── proj status ───────────────────────────────────────────────────────────────
cmd_status() {
    local chosen="$1"
    [[ -n "$chosen" ]] || chosen=$(_pick_project "Статус проекта") || return

    local SSD_PROJECT=$(_project_ssd_path "$chosen")
    local HDD_PROJECT=$(_project_hdd_path "$chosen")
    local total_hdd=0 total_symlinks=0 total_proxies=0

    print -P "\n%B%F{cyan}┌─ ${chosen}%f%b"

    local -a cams=( "${SSD_PROJECT}/02_Sources/Video"/Cam_*(N/) )
    (( ${#cams} )) || print -P "%B%F{cyan}│%f%b  %F{yellow}⚠%f  Нет папок Cam_* в 02_Sources/Video"

    for ssd_cam in "${cams[@]}"; do
        local cam_name=$(basename "$ssd_cam")
        local hdd_cam="${HDD_PROJECT}/02_Sources/Video/${cam_name}"
        local ssd_links=$(find "$ssd_cam" -maxdepth 1 -type l | wc -l | tr -d ' ')
        local hdd_files=0
        [[ -d "$hdd_cam" ]] && hdd_files=$(find "$hdd_cam" -maxdepth 1 -type f | wc -l | tr -d ' ')
        local proxy_count=$(find "${ssd_cam}/Proxy" -maxdepth 1 -type f 2>/dev/null | wc -l | tr -d ' ')
        (( total_hdd += hdd_files ))
        (( total_symlinks += ssd_links ))
        (( total_proxies += proxy_count ))
        local icon
        if (( hdd_files > 0 && ssd_links == hdd_files )); then icon="%F{green}✓%f"
        elif (( ssd_links > 0 ));                           then icon="%F{yellow}~%f"
        else                                                      icon="%F{red}○%f"
        fi
        print -P "%B%F{cyan}│%f%b  ${icon}  ${cam_name}   HDD: ${hdd_files}   симлинки: ${ssd_links}   прокси: ${proxy_count}"
    done

    local ssd_size=$(du -sh "$SSD_PROJECT" 2>/dev/null | cut -f1)
    print -P "%B%F{cyan}│%f%b"
    print -P "%B%F{cyan}│%f%b  SSD: ${ssd_size}   исходников: ${total_hdd}   симлинков: ${total_symlinks}   прокси: ${total_proxies}"
    print -P "%B%F{cyan}└────────────────────────────────────────┘%f%b\n"
}

# ── proj sync ────────────────────────────────────────────────────────────────
cmd_sync() {
    print -P "\n%B%F{cyan}Sync Footage%f%b\n"

    if [[ ! -d "$HDD_SOURCES_ROOT" ]]; then
        print -P "%F{red}✗ HDD не смонтирован: ${HDD_SOURCES_ROOT}%f\n"; return 1
    fi

    local chosen="$1"
    [[ -n "$chosen" ]] || chosen=$(_pick_project "Синхронизация") || return

    local SSD_PROJECT=$(_project_ssd_path "$chosen")
    local HDD_PROJECT=$(_project_hdd_path "$chosen")

    if [[ ! -d "$HDD_PROJECT" ]]; then
        print -P "%F{red}✗ Проект не найден на HDD: ${HDD_PROJECT}%f\n"; return 1
    fi

    print -P "%B▶ Проект:%b ${chosen}\n"
    local synced=0 skipped=0

    for hdd_cam in "${HDD_PROJECT}/02_Sources/Video"/Cam_*(N/); do
        local cam_name=$(basename "$hdd_cam")
        local ssd_cam="${SSD_PROJECT}/02_Sources/Video/${cam_name}"
        mkdir -p "${ssd_cam}/Proxy"
        print -P "%B%F{cyan}📁 ${cam_name}%f%b"

        for hdd_file in "${hdd_cam}/"*(N-.); do
            local filename=$(basename "$hdd_file")
            local ssd_link="${ssd_cam}/${filename}"
            if [[ ! -e "$ssd_link" && ! -L "$ssd_link" ]]; then
                ln -s "$hdd_file" "$ssd_link"
                (( synced++ ))
                print -P "  %F{green}→%f symlink  ${filename}"
            else
                (( skipped++ ))
            fi
        done

        for proxy_file in "${hdd_cam}/Proxy/"*(N-.); do
            local filename=$(basename "$proxy_file")
            local ssd_proxy="${ssd_cam}/Proxy/${filename}"
            # несовпадение размера = недокачанная копия, докачиваем
            if [[ -e "$ssd_proxy" ]] && (( $(_stat_size "$ssd_proxy") == $(_stat_size "$proxy_file") )); then
                (( skipped++ ))
            else
                copy_with_progress "$proxy_file" "$ssd_proxy" "Proxy/${filename}" || true
                (( synced++ ))
            fi
        done
    done

    [[ "$_OS" == "macos" ]] && afplay /System/Library/Sounds/Glass.aiff 2>/dev/null || true
    print -P "\n%F{green}%B✅ Синхронизация завершена:%b ${synced} новых, ${skipped} уже было.%f\n"
}

# ── proj open ────────────────────────────────────────────────────────────────
cmd_open() {
    local chosen="$1"
    [[ -n "$chosen" ]] || chosen=$(_pick_project "Открыть папку проекта") || return
    _reveal "$(_project_ssd_path "$chosen")"
}

# ── proj archive ─────────────────────────────────────────────────────────────
cmd_archive() {
    print -P "\n%B%F{cyan}Архивирование проекта%f%b\n"

    if [[ ! -d "$HDD_SOURCES_ROOT" ]]; then
        print -P "%F{red}✗ HDD не смонтирован: ${HDD_SOURCES_ROOT}%f\n"; return 1
    fi

    local chosen="$1"
    [[ -n "$chosen" ]] || chosen=$(_pick_project "Архивировать проект") || return

    local SSD_PROJECT=$(_project_ssd_path "$chosen")
    local HDD_PROJECT=$(_project_hdd_path "$chosen")
    if [[ ! -d "$SSD_PROJECT" || "${SSD_PROJECT:A}" == "${HDD_PROJECT:A}" ]]; then
        print -P "%F{red}✗ Некорректный путь проекта: ${SSD_PROJECT}%f\n"; return 1
    fi
    local ssd_size=$(du -sh "$SSD_PROJECT" 2>/dev/null | cut -f1)

    print -P "%B▶ Проект:%b ${chosen}  (SSD: ${ssd_size})"
    print -P "  → ${HDD_PROJECT}"
    print -P "  Симлинки будут удалены, папка на SSD — стёрта после переноса и сверки.\n"
    if ! _confirm "Архивировать ${chosen:t}?"; then
        print -P "%F{red}Отменено.%f\n"; return
    fi

    # Только обычные файлы: симлинки указывают на HDD, на архивной копии не нужны
    local -a files=( "$SSD_PROJECT"/**/*(ND.) )
    local f rel

    # Файл с тем же путём уже есть на HDD, но другого размера — rsync молча
    # перезаписал бы его. Останавливаемся до каких-либо изменений.
    local -a conflicts
    for f in "${files[@]}"; do
        [[ "${f:t}" == (.DS_Store|._*) ]] && continue
        rel="${f#${SSD_PROJECT}/}"
        [[ -e "${HDD_PROJECT}/${rel}" ]] || continue
        (( $(_stat_size "$f") == $(_stat_size "${HDD_PROJECT}/${rel}") )) || conflicts+=( "$rel" )
    done
    if (( ${#conflicts} )); then
        print -P "\n%F{red}✗ На HDD уже есть другие файлы с теми же путями:%f"
        for rel in "${conflicts[@]}"; do print -r -- "    $rel"; done
        print -P "%F{red}  Архивирование остановлено, ничего не изменено.%f"
        print -P "  Переименуй или удали лишнюю версию (на SSD или в ${HDD_PROJECT}) и повтори.\n"
        return 1
    fi

    # Запоминаем симлинки (путь → цель), чтобы вернуть их, если перенос сорвётся
    local links_f=$(mktemp)
    local l
    for l in "$SSD_PROJECT"/**/*(ND@); do
        print -r -- "${l}"$'\t'"$(readlink "$l")"
    done > "$links_f"
    local links=$(wc -l < "$links_f" | tr -d ' ')
    find "$SSD_PROJECT" -type l -delete
    print -P "\n  %F{green}✓%f  Удалено симлинков: ${links}"

    print -P "  %F{yellow}⬇%f  Переношу на HDD..."
    mkdir -p "$HDD_PROJECT"
    local _ok=false
    if command -v rsync &>/dev/null; then
        rsync -a "$SSD_PROJECT/" "$HDD_PROJECT/" && _ok=true
    else
        cp -Rp "$SSD_PROJECT/." "$HDD_PROJECT/" && _ok=true
    fi

    # Сверка: каждый файл с SSD должен лежать на HDD и совпадать по размеру
    local -a bad
    if [[ "$_ok" == true ]]; then
        print -P "  %F{yellow}⟳%f  Сверяю ${#files} файлов..."
        for f in "${files[@]}"; do
            rel="${f#${SSD_PROJECT}/}"
            if [[ ! -f "${HDD_PROJECT}/${rel}" ]] || \
               (( $(_stat_size "$f") != $(_stat_size "${HDD_PROJECT}/${rel}") )); then
                bad+=( "$rel" )
            fi
        done
        (( ${#bad} )) && _ok=false
    fi

    if [[ "$_ok" == true ]]; then
        rm -f "$links_f"
        rm -rf "$SSD_PROJECT"
        print -P "  %F{green}✓%f  Папка на SSD удалена"
        [[ "$_OS" == "macos" ]] && afplay /System/Library/Sounds/Glass.aiff 2>/dev/null || true
        print -P "\n%F{green}%B✅ Проект в архиве:%b ${HDD_PROJECT}  (освобождено ~${ssd_size})%f\n"
    else
        local t
        while IFS=$'\t' read -r l t; do
            [[ -e "$l" || -L "$l" ]] || ln -s "$t" "$l"
        done < "$links_f"
        rm -f "$links_f"
        if (( ${#bad} )); then
            print -P "\n%F{red}✗ Не сошлись после копирования (${#bad}):%f"
            for rel in "${bad[@]:0:20}"; do print -r -- "    $rel"; done
            (( ${#bad} > 20 )) && print -r -- "    … и ещё $(( ${#bad} - 20 ))"
        fi
        print -P "\n%F{red}✗ Ошибка переноса — папка на SSD и симлинки сохранены: ${SSD_PROJECT}%f\n"
        return 1
    fi
}

# ── proj settings ────────────────────────────────────────────────────────────
cmd_settings() {
    local -a keys=( PROJECTS_PARENT_ROOT SSD_PROJECTS_ROOT HDD_SOURCES_ROOT PREMIERE_TEMPLATE )
    local -A names=(
        PROJECTS_PARENT_ROOT "Корень с категориями"
        SSD_PROJECTS_ROOT    "Проекты на SSD"
        HDD_SOURCES_ROOT     "Исходники на HDD"
        PREMIERE_TEMPLATE    "Шаблон Premiere"
    )
    local -a items
    local key val sel act new_val label
    integer idx
    while true; do
        source "$CONFIG_FILE"
        items=()
        for key in "${keys[@]}"; do
            val="${(P)key}"
            label="$(printf '%-22s' "${names[$key]}")${val:-—}"
            [[ -n "$val" && ! -e "$val" ]] && label+="  ⚠ не найден"
            items+=( "$label" )
        done

        sel=$(_choose "Настройки" "${items[@]}" "Шаблон папок" "$_BACK") || return 0
        case "$sel" in
            "$_BACK")       return 0 ;;
            "Шаблон папок") _reveal "$TEMPLATE_DIR"; continue ;;
        esac
        idx=${items[(ie)$sel]}
        (( idx <= ${#keys} )) || continue
        key="${keys[$idx]}"; val="${(P)key}"

        act=$(_choose "Настройки › ${names[$key]}: ${val:-—}" "Изменить" "Сбросить" "$_BACK") || continue
        case "$act" in
            "Изменить")
                new_val=$(_input "${names[$key]}" "$val" "/Volumes/…") || continue
                if [[ -n "$new_val" && "$new_val" != "$val" ]]; then
                    _config_set "$key" "$new_val"
                    print -P "  %F{green}✓%f  ${names[$key]}: ${new_val}"
                fi
                ;;
            "Сбросить")
                if _confirm "Сбросить «${names[$key]}»?"; then
                    _config_del "$key"
                    print -P "  %F{green}✓%f  ${names[$key]} сброшен"
                fi
                ;;
        esac
    done
}

# ── главное меню ─────────────────────────────────────────────────────────────
# Studio Tools → Проекты → <проект> → действие. Esc везде — на уровень выше,
# вывод команд остаётся на экране над меню.
cmd_menu() {
    [[ -f "$_UPDATE_FILE" ]] && \
        print -P "%F{yellow}  ⬆  Доступно обновление → «Обновить Studio Tools»%f"
    print -P "%F{240}  ↑↓ выбор · Enter открыть · Esc назад · Ctrl+C выход%f\n"
    local sel
    while true; do
        sel=$(_choose "Studio Tools ${PROJ_VERSION}" \
            "Проекты" "Новый проект" "Настройки" "Шаблон папок" "Обновить Studio Tools" "Выход") \
            || return 0
        case "$sel" in
            "Проекты")               _browse_projects ;;
            "Новый проект")          cmd_new ;;
            "Настройки")             cmd_settings ;;
            "Шаблон папок")          _reveal "$TEMPLATE_DIR" ;;
            "Обновить Studio Tools") cmd_update ;;
            "Выход")                 return 0 ;;
        esac
    done
}

_browse_projects() {
    local chosen
    while true; do
        chosen=$(_pick_project "Проекты") || return 0
        _project_menu "$chosen"
    done
}

# Проект выбран один раз — дальше любые действия с ним, пока не нажат Esc
_project_menu() {
    local chosen="$1" act
    cmd_status "$chosen"
    while true; do
        # после архивирования папки на SSD больше нет — возвращаемся к списку
        [[ -d "$(_project_ssd_path "$chosen")" ]] || return 0
        act=$(_choose "Проекты › ${chosen}" \
            "Статус" "Синхронизировать footage" "Media Log (CSV)" "Открыть папку" "Архивировать" "$_BACK") \
            || return 0
        case "$act" in
            "Статус")                   cmd_status  "$chosen" ;;
            "Синхронизировать footage") cmd_sync    "$chosen" ;;
            "Media Log (CSV)")          cmd_meta    "$chosen" ;;
            "Открыть папку")            cmd_open    "$chosen" ;;
            "Архивировать")             cmd_archive "$chosen" ;;
            "$_BACK")                   return 0 ;;
        esac
    done
}

# ── proj meta ────────────────────────────────────────────────────────────────
# Каждое поле в кавычках, внутренние " удваиваются (RFC 4180) —
# запятые и кавычки в именах файлов не ломают колонки
_csv_row() {
    local -a out
    local f
    for f in "$@"; do out+=( "\"${f//\"/\"\"}\"" ); done
    print -r -- "${(j:,:)out}"
}

cmd_meta() {
    if ! command -v mediainfo &>/dev/null; then
        print -P "%F{red}✗ mediainfo не установлен. Запусти: brew install mediainfo%f\n"; return 1
    fi

    local chosen="$1"
    [[ -n "$chosen" ]] || chosen=$(_pick_project "Media Log") || return

    local SSD_PROJECT=$(_project_ssd_path "$chosen")
    local CSV_OUT="${SSD_PROJECT}/00_Admin/media_log.csv"
    local count=0 skipped=0

    print -P "\n%B%F{cyan}▶ Media Log:%b ${chosen}%f\n"

    printf "camera,filename,shot_date,duration,codec,resolution,fps,size_mb\n" > "$CSV_OUT"

    for cam_dir in "${SSD_PROJECT}/02_Sources/Video"/Cam_*(N/); do
        local cam_name=$(basename "$cam_dir")
        print -P "  %B%F{cyan}📁 ${cam_name}%f%b"

        for f in "${cam_dir}/"*(N-.); do
            local filename=$(basename "$f")
            local ext="${filename:l:e}"
            [[ "$ext" == (mp4|mov|mxf|avi|r3d|braw|mts|m2ts) ]] || continue

            # Один вызов на General, один на Video
            local g v
            g=$(mediainfo --Inform="General;%Encoded_Date%|%Tagged_Date%|%FileSize%|%Duration/String3%" "$f" 2>/dev/null)
            v=$(mediainfo --Inform="Video;%Format%|%Width%|%Height%|%FrameRate%" "$f" 2>/dev/null)

            local shot_date duration size_bytes size_mb codec width height fps
            shot_date="${g%%|*}"; g="${g#*|}"
            local tagged="${g%%|*}"; g="${g#*|}"
            size_bytes="${g%%|*}"; g="${g#*|}"
            duration="${g}"
            [[ -z "$shot_date" ]] && shot_date="$tagged"
            [[ -z "$shot_date" ]] && shot_date="unknown"

            codec="${v%%|*}"; v="${v#*|}"
            width="${v%%|*}"; v="${v#*|}"
            height="${v%%|*}"; v="${v#*|}"
            fps="${v}"
            size_mb=$(printf "%.1f" $(( ${size_bytes:-0} / 1048576.0 )) 2>/dev/null || echo "0")
            local res="${width}x${height}"

            _csv_row "$cam_name" "$filename" "$shot_date" "$duration" \
                "$codec" "$res" "$fps" "$size_mb" >> "$CSV_OUT"

            print -P "    %F{green}✓%f  ${filename}  %F{240}${shot_date}%f"
            (( count++ ))
        done
    done

    print -P "\n%F{green}%B✅ ${count} файлов → ${CSV_OUT}%f%b\n"
    [[ "$_OS" == "macos" ]] && open "$CSV_OUT" || true
}

# ── proj update ───────────────────────────────────────────────────────────────
cmd_update() {
    print -P "\n%B%F{cyan}Обновление Studio Tools...%f%b\n"
    if ! git -C "$STUDIO_DIR" pull; then
        print -P "\n%F{red}✗ Ошибка. Запусти: git -C ~/.studio-tools pull%f\n"
        return 1
    fi

    local new_proj="${STUDIO_DIR}/bin/proj"
    local cur_proj="$HOME/bin/proj"

    # Если бинарь изменился — копируем и перезапускаем новую версию для деплоя
    if ! diff -q "$new_proj" "$cur_proj" &>/dev/null; then
        cp "$new_proj" "$cur_proj" && chmod +x "$cur_proj"
        print -P "  %F{green}✓%f  bin/proj (новая версия — перезапускаю деплой)"
        exec "$cur_proj" _deploy
    fi

    # Бинарь уже актуален — деплоим остальное
    "$cur_proj" _deploy
}

cmd_deploy() {
    if [[ -f "${STUDIO_DIR}/bin/sf" ]]; then
        cp "${STUDIO_DIR}/bin/sf" "$HOME/bin/sf" && chmod +x "$HOME/bin/sf"
        print -P "  %F{green}✓%f  bin/sf"
    fi

    # остаток интеграции с Nimble Commander из старых версий
    rm -rf "$HOME/bin/minfo.app"

    rm -f "$_UPDATE_FILE"
    local ver=$(git -C "$STUDIO_DIR" rev-parse --short HEAD 2>/dev/null)
    print -P "\n%F{green}%B✅ Обновлено до ${ver}.%f%b\n"
}

# ── proj help ────────────────────────────────────────────────────────────────
cmd_help() {
    print -P "
%B%F{cyan}proj ${PROJ_VERSION}%f%b — Studio Tools

  %Bproj%b                Главное меню
  %Bproj new%b            Создать новый проект
  %Bproj open%b           Открыть папку проекта в Finder
  %Bproj status%b         Статус проекта (HDD / симлинки / прокси)
  %Bproj sync%b           Синхронизировать footage с HDD
  %Bproj archive%b        Архивировать проект (SSD → HDD)
  %Bproj meta%b           Media Log — CSV с метаданными footage
  %Bproj settings%b       Настройки (пути, шаблон папок)
  %Bproj template%b       Открыть шаблон папок в Finder
  %Bproj update%b         Обновить studio-tools
"
}

# ════════════════════════════════════════════════════════════════════════════
# РОУТЕР
# ════════════════════════════════════════════════════════════════════════════

# Фоновая проверка обновлений
(
    if [[ ! -f "$_UPDATE_CACHE" ]] || \
       (( $(date +%s) - $(_stat_mtime "$_UPDATE_CACHE") > 21600 )); then
        touch "$_UPDATE_CACHE"
        if git -C "$STUDIO_DIR" fetch origin main --quiet 2>/dev/null; then
            local behind=$(git -C "$STUDIO_DIR" rev-list HEAD..origin/main --count 2>/dev/null)
            (( behind > 0 )) && echo "$behind" > "$_UPDATE_FILE" || rm -f "$_UPDATE_FILE"
        fi
    fi
) &>/dev/null &

case "$1" in
    new)      cmd_new ;;
    open)     cmd_open ;;
    status)   cmd_status ;;
    sync)     cmd_sync ;;
    archive)  cmd_archive ;;
    meta)     cmd_meta ;;
    settings) cmd_settings ;;
    template) _reveal "$TEMPLATE_DIR" ;;
    menu)     cmd_menu ;;
    update)   cmd_update ;;
    _deploy)  cmd_deploy ;;
    help|-h|--help) cmd_help ;;
    "")       cmd_menu ;;
    *)
        print -P "%F{red}Неизвестная команда: $1%f"
        cmd_help; exit 1
        ;;
esac
